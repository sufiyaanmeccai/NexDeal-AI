# ============================================================
# .env.example — NexDeal AI  |  Phase 0 configuration template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Where to find these values:
#   FOUNDRY_PROJECT_ENDPOINT — Microsoft Foundry portal → your project home page
#     Format: https://<ai-services-account>.services.ai.azure.com/api/projects/<project-name>
#
#   FOUNDRY_MODEL_NAME — Microsoft Foundry portal → Deployed models table → "Name" column
#     This is the DEPLOYMENT name, which may differ from the model family name.
# ============================================================

FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_NAME=

# FOUNDRY_AGENT_RESPONSES_ENDPOINT — The deployed Responses Hosted Agent URL
FOUNDRY_AGENT_RESPONSES_ENDPOINT=

# ============================================================
# Telemetry Configuration (Phase 9)
# ============================================================
# ENABLE_TELEMETRY — Set to "true" to export telemetry (Console or Azure).
# Defaults to "false".
ENABLE_TELEMETRY=false

# APPLICATIONINSIGHTS_CONNECTION_STRING — Azure Monitor connection string.
# If ENABLE_TELEMETRY is true and this is empty, telemetry is exported to the local console.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# LOG_SENSITIVE_DATA — Set to "true" to capture sensitive customer/request data in traces.
# Defaults to "false".
LOG_SENSITIVE_DATA=false
